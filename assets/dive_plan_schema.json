{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechnicalScubaDivePlanConfig",
  "description": "Schema for Bühlmann ZH-L16C + Gradient Factors dive planning configuration and inputs.",
  "type": "object",
  "properties": {
    "dive_mode": {
      "type": "string",
      "enum": ["OC", "CCR"],
      "default": "OC"
    },
    "include_bailout": {
      "type": "boolean",
      "default": true
    },
    "zhl16c_comp1_variant": {
      "type": "string",
      "enum": ["1b", "1"],
      "default": "1b"
    },
    "gf_low": {
      "type": "number",
      "minimum": 1,
      "maximum": 100,
      "default": 30
    },
    "gf_high": {
      "type": "number",
      "minimum": 1,
      "maximum": 100,
      "default": 85
    },
    "o2_narcotic": {
      "type": "boolean",
      "default": true
    },
    "depth_units": {
      "type": "string",
      "enum": ["feet", "meters"],
      "default": "feet"
    },
    "volume_units": {
      "type": "string",
      "enum": ["cuft", "liters"],
      "default": "cuft"
    },
    "pressure_units": {
      "type": "string",
      "enum": ["psi", "bar"],
      "default": "psi"
    },
    "setpoint_units": {
      "type": "string",
      "enum": ["ATA", "BAR"],
      "default": "ATA"
    },
    "elevation_ft": {
      "type": "number",
      "minimum": 0,
      "maximum": 15000,
      "default": 0
    },
    "water_type": {
      "type": "string",
      "enum": ["salt", "fresh"],
      "default": "salt"
    },
    "stop_size": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 10
    },
    "last_oc_stop": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 10
    },
    "last_ccr_stop": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 10
    },
    "min_stop_time_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 60
    },
    "descent_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 60
    },
    "ascent_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 30
    },
    "deco_ascent_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 30
    },
    "surface_ascent_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 10
    },
    "bottom_rmv": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 0.75
    },
    "deco_rmv": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 0.60
    },
    "ccr_setpoint_bottom": {
      "type": "number",
      "minimum": 0.4,
      "maximum": 1.6,
      "default": 1.2
    },
    "ccr_setpoint_deco": {
      "type": "number",
      "minimum": 0.4,
      "maximum": 1.6,
      "default": 1.3
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["depth", "time_min"],
        "properties": {
          "depth": { "type": "number", "minimum": 0, "maximum": 1000 },
          "time_min": { "type": "number", "exclusiveMinimum": 0 },
          "gas_name": { "type": "string" }
        }
      }
    },
    "oc_gases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "f_o2", "f_he"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["bottom", "travel", "deco"] },
          "f_o2": { "type": "number", "minimum": 0.01, "maximum": 1.0 },
          "f_he": { "type": "number", "minimum": 0.0, "maximum": 0.99 },
          "max_po2": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
          "switch_depth": { "type": "number", "minimum": 0 },
          "cylinder_preset": { "type": "string" },
          "start_pressure_psi": { "type": "number", "exclusiveMinimum": 0 },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    },
    "ccr_diluent": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "f_o2": { "type": "number", "minimum": 0.01, "maximum": 1.0 },
        "f_he": { "type": "number", "minimum": 0.0, "maximum": 0.99 }
      }
    },
    "bailout_gases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "f_o2", "f_he"],
        "properties": {
          "name": { "type": "string" },
          "f_o2": { "type": "number", "minimum": 0.01, "maximum": 1.0 },
          "f_he": { "type": "number", "minimum": 0.0, "maximum": 0.99 },
          "max_po2": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
          "switch_depth": { "type": "number", "minimum": 0 },
          "cylinder_preset": { "type": "string" },
          "start_pressure_psi": { "type": "number", "exclusiveMinimum": 0 },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    }
  },
  "required": ["dive_mode", "segments"]
}
